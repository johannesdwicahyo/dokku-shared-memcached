#!/usr/bin/env bash
set -euo pipefail
[[ "${DOKKU_TRACE:-}" == "1" ]] && set -x

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=config
source "$PLUGIN_ROOT/config"
# shellcheck source=functions
source "$PLUGIN_ROOT/functions"

mkdir -p "$PLUGIN_DATA_ROOT"
chmod 0750 "$PLUGIN_DATA_ROOT"

docker image pull "${PLUGIN_IMAGE}:${PLUGIN_IMAGE_VERSION}"

ensure_shared_container

# Every runtime invocation of the plugin's subcommands runs as 'dokku' (via
# SSH or the dokku CLI), not root. Memcached has no persistent volume, so the
# whole data root can be dokku-owned.
if id -u dokku >/dev/null 2>&1; then
  chown -R dokku:dokku "$PLUGIN_DATA_ROOT"
fi

# Install the periodic quota check. Operators can disable by removing this file.
CRON_FILE="/etc/cron.d/dokku-shared-memcached"
if [[ -w "$(dirname "$CRON_FILE")" || "$(id -u)" -eq 0 ]]; then
  cat >"$CRON_FILE" <<'CRON_EOF'
# Periodic quota enforcement for dokku-shared-memcached tenants.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * dokku dokku shared-memcached:check-quotas >/dev/null 2>&1
CRON_EOF
  chmod 0644 "$CRON_FILE" || true
  echo "shared-memcached: installed cron at $CRON_FILE"
else
  echo "shared-memcached: skipped cron install (no write permission to /etc/cron.d)" >&2
fi

echo "shared-memcached: install complete"
