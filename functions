#!/usr/bin/env bash
# Shared helpers for shared-memcached. Sourced — never executed directly.
set -euo pipefail

validate_name() {
  local name="${1:-}"
  [[ -n "$name" ]] || return 1
  [[ "$name" =~ $PLUGIN_NAME_REGEX ]] || return 1
}

service_exists() {
  local name="$1"
  [[ -d "$PLUGIN_DATA_ROOT/$name" ]]
}

service_list() {
  [[ -d "$PLUGIN_DATA_ROOT" ]] || return 0
  local d
  for d in "$PLUGIN_DATA_ROOT"/*/; do
    [[ -d "$d" ]] || continue
    local name="${d%/}"
    name="${name##*/}"
    [[ "$name" == .* ]] && continue
    # Anything starting with `_` is reserved for plugin internals.
    [[ "$name" == _* ]] && continue
    printf '%s\n' "$name"
  done | sort
}

service_url() {
  printf '%s:%s\n' "$PLUGIN_CONTAINER_NAME" "$PLUGIN_DB_PORT"
}

# Speak the memcached text protocol to the shared container and echo the reply.
# Runs `nc` INSIDE the container against loopback, so the host needs no
# memcached client and does not depend on the container hostname resolving
# from the host. busybox `nc` ships in memcached:alpine. All callers route
# through here. The payload arrives on stdin; `quit` closes the connection so
# nc exits cleanly.
run_memcached_admin() {
  local payload="$1"
  printf '%s\r\nquit\r\n' "$payload" | \
    docker exec -i "$PLUGIN_CONTAINER_NAME" nc -w 2 127.0.0.1 "$PLUGIN_DB_PORT"
}

# Echo lines of the form `<plain-text-key> <size_bytes>` whose key starts
# with <prefix>. Memcached has no native "list keys by prefix", and the
# legacy `stats cachedump` path is unreliable in modern memcached (it
# only inspects the hot slab and frequently returns END even when keys
# exist). `lru_crawler metadump all` is the supported alternative —
# walks every LRU and returns one `key=<urlencoded> ... size=<bytes>`
# line per key, terminated by `END`.
#
# Keys are returned URL-encoded (e.g. `tenant%3Ahello` for `tenant:hello`)
# so we decode `%XX` back to the literal byte before prefix-matching.
tenant_scan() {
  local prefix="$1"
  # `lru_crawler metadump all` is the supported replacement for the
  # flaky `stats cachedump`. Each key line is:
  #   key=<urlencoded> exp=N la=N cas=N fetch=N cls=N size=N flags=N
  # Memcached only URL-encodes bytes outside the printable-ASCII set
  # (in practice: ":", "%", spaces). We decode `%XX` portably (no
  # gawk-only strtonum) so this works on busybox awk / mawk too.
  run_memcached_admin "lru_crawler metadump all" \
    | awk -v prefix="$prefix" '
        BEGIN {
          OFS = " "
          hex = "0123456789abcdef"
        }
        function fromhex(h,    i, c, n) {
          n = 0
          for (i = 1; i <= length(h); i++) {
            c = tolower(substr(h, i, 1))
            n = n * 16 + (index(hex, c) - 1)
          }
          return n
        }
        /^key=/ {
          encoded = $1; sub(/^key=/, "", encoded)
          size = ""
          for (i = 2; i <= NF; i++) {
            if ($i ~ /^size=/) { size = substr($i, 6); break }
          }
          plain = encoded
          while (match(plain, /%[0-9A-Fa-f][0-9A-Fa-f]/)) {
            b = fromhex(substr(plain, RSTART + 1, 2))
            plain = substr(plain, 1, RSTART - 1) sprintf("%c", b) substr(plain, RSTART + RLENGTH)
          }
          if (index(plain, prefix) == 1) print plain, size
        }
      '
}

# Echo "<key_count> <byte_total>" for the tenant prefix.
tenant_usage() {
  local name="$1" key b keys=0 bytes=0
  while IFS=' ' read -r key b; do
    [[ -z "$key" ]] && continue
    keys=$((keys + 1))
    [[ -n "$b" ]] && bytes=$((bytes + b))
  done < <(tenant_scan "${name}:")
  printf '%s %s\n' "$keys" "$bytes"
}

# Delete every key under "<name>:" — used by destroy and over-quota flush.
# No native prefix flush exists, so we scan then batch the deletes.
# tenant_scan now returns "<plain-key> <size>" lines (post-metadump
# refactor), so the key is field 1, not field 2.
purge_tenant_keys() {
  local name="$1" key _size payload=""
  while IFS=' ' read -r key _size; do
    [[ -z "$key" ]] && continue
    payload+="delete $key"$'\r\n'
  done < <(tenant_scan "${name}:")
  [[ -n "$payload" ]] || return 0
  run_memcached_admin "$payload" >/dev/null || true
}

# Make sure the shared Memcached container is up. Idempotent. No volume:
# memcached is volatile by design.
ensure_shared_container() {
  local existing
  existing="$(docker ps --filter "name=^${PLUGIN_CONTAINER_NAME}$" --format '{{.Names}}' || true)"
  if [[ -n "$existing" ]]; then
    return 0
  fi

  docker network create "$PLUGIN_NETWORK_NAME" >/dev/null 2>&1 || true

  docker run --detach \
    --name "$PLUGIN_CONTAINER_NAME" \
    --network "$PLUGIN_NETWORK_NAME" \
    --restart always \
    --memory "${PLUGIN_MEMCACHED_MB}m" \
    "${PLUGIN_IMAGE}:${PLUGIN_IMAGE_VERSION}" \
    memcached -m "$PLUGIN_MEMCACHED_MB" -p "$PLUGIN_DB_PORT" \
    >/dev/null
}

service_create() {
  local name="$1"
  validate_name "$name" || { echo "invalid tenant name: $name" >&2; return 2; }
  if service_exists "$name"; then
    echo "service already exists: $name" >&2
    return 3
  fi
  ensure_shared_container

  # A tenant is pure config — a key prefix and a link list. Memcached needs
  # no provisioning for a prefix to start working.
  mkdir -p "$PLUGIN_DATA_ROOT/$name"
  : >"$PLUGIN_DATA_ROOT/$name/LINKS"
}

service_destroy() {
  local name="$1"
  validate_name "$name" || { echo "invalid tenant name: $name" >&2; return 2; }
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi

  purge_tenant_keys "$name"
  rm -rf "${PLUGIN_DATA_ROOT:?}/$name"
}

service_get_quota_mb() {
  local name="$1"
  local f="$PLUGIN_DATA_ROOT/$name/QUOTA_MB"
  if [[ -s "$f" ]]; then
    cat "$f"
  else
    printf '%s' "$PLUGIN_DEFAULT_QUOTA_MB"
  fi
}

service_set_quota() {
  local name="$1" mb="${2:-}"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  if [[ -z "$mb" ]]; then
    echo "usage: set-quota <name> <mb>" >&2
    return 2
  fi
  [[ "$mb" =~ ^[1-9][0-9]*$ ]] || { echo "quota <mb> must be a positive integer: $mb" >&2; return 2; }
  printf '%s' "$mb" >"$PLUGIN_DATA_ROOT/$name/QUOTA_MB"
}

service_unset_quota() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  rm -f "$PLUGIN_DATA_ROOT/$name/QUOTA_MB"
}

# Sweep one tenant: if its prefix exceeds the byte cap, flush the prefix and
# log a line (captured by cron output for alerting). Memcached cannot make a
# tenant read-only, so flushing is the enforcement lever. Silent when under.
service_check_quota() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }

  local quota_mb usage keys bytes cap_bytes
  quota_mb="$(service_get_quota_mb "$name")"
  usage="$(tenant_usage "$name")"
  keys="${usage% *}"
  bytes="${usage#* }"
  [[ -z "$keys" ]]  && keys=0
  [[ -z "$bytes" ]] && bytes=0
  cap_bytes=$((quota_mb * 1024 * 1024))

  if (( bytes > cap_bytes )); then
    purge_tenant_keys "$name"
    printf 'flushed name=%s keys=%s bytes=%s cap_bytes=%s\n' \
      "$name" "$keys" "$bytes" "$cap_bytes"
  fi
}

service_info() {
  local name="$1"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi

  local usage keys bytes links_csv quota_mb
  usage="$(tenant_usage "$name")"
  keys="${usage% *}"
  bytes="${usage#* }"
  quota_mb="$(service_get_quota_mb "$name")"

  if [[ -s "$PLUGIN_DATA_ROOT/$name/LINKS" ]]; then
    links_csv="$(tr '\n' ',' <"$PLUGIN_DATA_ROOT/$name/LINKS")"
    links_csv="${links_csv%,}"
  else
    links_csv=""
  fi

  printf 'name=%s\n'         "$name"
  printf 'key_prefix=%s:\n'  "$name"
  printf 'host=%s\n'         "$PLUGIN_CONTAINER_NAME"
  printf 'port=%s\n'         "$PLUGIN_DB_PORT"
  printf 'keys=%s\n'         "$keys"
  printf 'memory_bytes=%s\n' "$bytes"
  printf 'quota_mb=%s\n'     "$quota_mb"
  printf 'linked_apps=%s\n'  "$links_csv"
}

service_link() {
  local name="$1" app="${2:-}"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi
  if [[ -z "$app" ]]; then
    echo "app name required" >&2
    return 2
  fi

  dokku config:set --no-restart "$app" \
    "MEMCACHED_URL=$(service_url)" \
    "MEMCACHED_KEY_PREFIX=${name}:"

  local links_file="$PLUGIN_DATA_ROOT/$name/LINKS"
  if ! grep -qx "$app" "$links_file" 2>/dev/null; then
    printf '%s\n' "$app" >>"$links_file"
  fi
}

service_unlink() {
  local name="$1" app="${2:-}"
  if ! service_exists "$name"; then
    echo "service does not exist: $name" >&2
    return 3
  fi
  if [[ -z "$app" ]]; then
    echo "app name required" >&2
    return 2
  fi

  dokku config:unset --no-restart "$app" MEMCACHED_URL MEMCACHED_KEY_PREFIX || true

  local links_file="$PLUGIN_DATA_ROOT/$name/LINKS"
  if [[ -f "$links_file" ]]; then
    grep -vx "$app" "$links_file" >"${links_file}.tmp" || true
    mv "${links_file}.tmp" "$links_file"
  fi
}

# Per-tenant export/import is a v0.2 stretch goal — see CLAUDE.md. Memcached
# is a volatile cache with no per-key auth and no native prefix dump, so a
# correct per-tenant snapshot needs a cachedump-walk that serialises every
# value/flag/TTL. These stubs keep the CLI surface stable until then.
service_export() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  echo "shared-memcached:export is not implemented in v0.1.0 (per-tenant backup is a v0.2 stretch goal); memcached is a volatile cache — back it with your source of truth, not snapshots" >&2
  return 1
}

service_import() {
  local name="$1"
  service_exists "$name" || { echo "service does not exist: $name" >&2; return 3; }
  echo "shared-memcached:import is not implemented in v0.1.0 (per-tenant backup is a v0.2 stretch goal)" >&2
  return 1
}
